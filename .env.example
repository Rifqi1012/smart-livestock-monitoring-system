# ── Database ──────────────────────────────────────────────
# MySQL connection string
DATABASE_URL="mysql://root:@localhost:3306/slms_db"

# ── Auth (NextAuth v5 / Auth.js) ──────────────────────────
# Generate: `npx auth secret`  atau  `openssl rand -base64 32`
AUTH_SECRET="change-me"
# Izinkan login lewat IP/host non-localhost (test di HP). Set true saat perlu.
AUTH_TRUST_HOST=true

# ── Web Push (VAPID) ──────────────────────────────────────
# Generate: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY="change-me-public"
VAPID_PRIVATE_KEY="change-me-private"
# Sama dengan VAPID_PUBLIC_KEY — dibutuhkan di sisi browser
NEXT_PUBLIC_VAPID_PUBLIC_KEY="change-me-public"
# Subject VAPID (mailto: atau https URL)
VAPID_SUBJECT="mailto:admin@slms.local"

# ── Device (ESP32) ────────────────────────────────────────
# API key untuk autentikasi POST /api/device/ingest (header x-api-key)
DEVICE_API_KEY="change-me-device-key"
